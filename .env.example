# =============================================================
# Smart Assistant — Variáveis de ambiente
# Copie este arquivo para `.env` e ajuste conforme necessário.
# =============================================================

# Endpoint do Ollama rodando localmente
OLLAMA_HOST=http://localhost:11434

# Modelo a ser usado (obrigatório por especificação do CP03)
OLLAMA_MODEL=gpt-oss:120b

# Se "1", o cliente LLM devolve respostas mockadas determinísticas
# (útil para CI ou quando o Ollama não está disponível).
LLM_OFFLINE=0
